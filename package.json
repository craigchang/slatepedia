{
  "name": "slatepedia",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server",
    "build": "npm --prefix react-ui install && npm --prefix react-ui run build",
    "postinstall": "npm run build",
    "check:no-generated-changes": "node scripts/check-no-generated-changes.js",
    "check:changelog": "node scripts/check-changelog.js",
    "check:openapi-min": "node scripts/check-openapi-min.js",
    "check:openapi-drift": "node scripts/check-openapi-drift.js",
    "check:all": "npm run check:no-generated-changes && npm run check:changelog && npm run check:openapi-min && npm run check:openapi-drift"
  },
  "cacheDirectories": [
    "node_modules",
    "react-ui/node_modules"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.16.3",
    "swagger-ui-express": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mars/heroku-cra-node.git"
  },
  "keywords": [
    "node",
    "heroku",
    "create-react-app",
    "react"
  ],
  "license": "MIT",
  "devDependencies": {}
}
